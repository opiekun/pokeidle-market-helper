{
  "manifest_version": 3,
  "name": "PokeIdle Market Helper",
  "version": "0.2.0",
  "description": "Read your listings and open native market listings by ID.",
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
